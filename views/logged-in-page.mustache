<html>
  <head>
    {{>header}}
  </head>

  <body class="container">
    <h1 class="mb-3">User Area</h1>

    <!-- Top alert with login status and actions -->
    <div class="alert alert-secondary" role="alert">
      <div class="d-flex justify-content-end align-items-center gap-2">
        {{#message}}
        {{#user}}
        <span class="me-2">
          Welcome, {{ user }}! {{ message }}.&nbsp; You are logged in as
          <strong>{{ role }}</strong
          >.
        </span>
        {{/user}}
        {{/message}}

        {{^user}}
        <a id="login" href="/login" class="btn btn-primary">Sign in</a>
        {{/user}}

        {{#user}}
        <a id="logout" href="/auth/logout" class="btn btn-primary">Sign out</a>
        {{/user}}
      </div>
    </div>

    <!-- Primary navigation (Bootstrap pills) -->
    <nav
      class="navbar bg-secondary-subtle rounded-3 px-3 py-2 mb-3"
      aria-label="Primary"
    >
      <ul class="nav nav-pills gap-2">
        <!-- Home -->
        <li class="nav-item">
          <a
            href="/"
            class="nav-link px-3 py-2 {{#nav.home}}active{{/nav.home}}"
            aria-current="{{#nav.home}}page{{/nav.home}}"
          >
            Home
          </a>
        </li>

        <!-- Site content (current page) -->
        {{#user}}
        <li class="nav-item">
          <a
            id="sitecontent"
            href="/user/content"
            class="nav-link px-3 py-2 {{#nav.site}}active{{/nav.site}}"
            aria-current="{{#nav.site}}page{{/nav.site}}"
          >
            Main content
          </a>
        </li>
        {{/user}}

        <!-- Admin (visible only for admin users) -->
        {{#admin}}
        <li class="nav-item">
          <a
            id="admincontent"
            href="/admin/admin"
            class="nav-link px-3 py-2 {{#nav.adminPage}}active{{/nav.adminPage}}"
            aria-current="{{#nav.adminPage}}page{{/nav.adminPage}}"
          >
            Admin
          </a>
        </li>
        {{/admin}}
      </ul>
    </nav>

    <!-- Main content for NORMAL USERS -->
    <div class="my-4 p-4 bg-light border rounded-3">
      <h2 class="mb-3">Welcome, Normal User</h2>
      <p class="lead">
        You are viewing content available to authenticated users with the role
        <strong><code>normalUsers</code></strong
        >.
      </p>

      <hr class="my-4" />

      <div class="mb-4">
        <h4>What you can do here</h4>
        <ul class="mb-0">
          <li>Access pages and resources available to registered users.</li>
          <li>View your user-specific content and data.</li>
          <li>Use features that require a signed-in session.</li>
        </ul>
      </div>

      <div class="mb-4">
        <h4>Need more permissions?</h4>
        <p class="mb-0">
          Some areas of the site are restricted to administrators only. If you
          believe you need additional access, please contact a site
          administrator.
        </p>
      </div>

      <div>
        <h4>Navigation tips</h4>
        <p class="mb-1">
          Use the navigation bar above to go back to the public pages or to
          explore other user content.
        </p>
        {{#admin}}
        <p class="text-warning mb-0">
          You have administrator rights. You can visit the admin area via the
          <strong>Admin</strong> tab in the navigation.
        </p>
        {{/admin}}
      </div>
    </div>
  </body>
</html>
